{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "igormarchetti.vercel.app"
        }
      ],
      "destination": "https://igormarchetti.me/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "igormarchetti.vercel.app"
        }
      ],
      "destination": "https://igormarchetti.me/:path*",
      "permanent": true
    },
    {
      "source": "/igor-marchetti-non-financial-risk-manager-v25-technology-risk.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/lippi",
      "destination": "https://lippi.igormarchetti.me/",
      "permanent": false
    },
    {
      "source": "/lippi/:path*",
      "destination": "https://lippi.igormarchetti.me/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/Igor_Marchetti_CV.pdf",
      "has": [{ "type": "query", "key": "download", "value": "1" }],
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Igor_Marchetti_Lippi_CV.pdf\""
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/igormarchetti.jpeg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
